{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/active-skill.schema.json",
  "title": "主动技能数据模型",
  "type": "object",
  "required": ["id", "name", "description", "element", "power", "accuracy", "energyCost", "priority"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "description": { "type": "string", "minLength": 1 },
    "element": {
      "type": "string",
      "enum": ["neutral", "fire", "water", "grass", "electric", "ice", "ground", "wind", "dark", "dragon", "rock", "normal"]
    },
    "power": { "type": "integer", "minimum": 1, "maximum": 200 },
    "accuracy": { "type": "integer", "minimum": 1, "maximum": 100 },
    "energyCost": { "type": "integer", "minimum": 0, "maximum": 100 },
    "priority": { "type": "integer", "minimum": -5, "maximum": 5 },
    "effect": {
      "type": "object",
      "required": ["status", "target", "chance", "duration", "magnitude"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["burn", "poison", "freeze", "attack-up", "defense-up", "speed-up"] },
        "target": { "type": "string", "enum": ["self", "opponent"] },
        "chance": { "type": "integer", "minimum": 1, "maximum": 100 },
        "duration": { "type": "integer", "minimum": 1, "maximum": 10 },
        "magnitude": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
