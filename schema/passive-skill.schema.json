{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/passive-skill.schema.json",
  "title": "被动技能（全局池）数据模型",
  "description": "原创幻兽养成网页游戏的全局被动特性数据表。",
  "type": "object",
  "required": ["id", "name", "category", "description", "tier"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "技能标识（slug），用于引用"
    },
    "name": {
      "type": "object",
      "description": "名称（多语言）",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "description": "中文名" },
        "en": { "type": "string", "description": "英文名" }
      }
    },
    "category": {
      "type": "string",
      "enum": ["attack", "defense", "work", "move", "element", "resource", "other"],
      "description": "效果分类"
    },
    "description": {
      "type": "string",
      "description": "效果描述（中文）"
    },
    "tier": {
      "type": "string",
      "enum": ["common", "rare", "legendary"],
      "description": "稀有度（common=普通, rare=稀有, legendary=传说）"
    }
  }
}
